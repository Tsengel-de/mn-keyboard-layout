// =============================================================================
// Mongolian Modern Ergonomic & DevOps-Friendly Keyboard Layout
// Author: Tsengel <tsengel@tsengel.de>
// Part of "Mongolian for All" / tsengel.de
//
// Key Innovations:
// - Q = Ө / ө (Feminine rounded vowel, matching Classical script ᠥ)
// - W = Ү / ү (Feminine high vowel, matching Classical script ᠦ)
// - Native DevOps keys preserved: [ ] { } \ | directly on physical keys
// - Full AltGr layer: Tugrik (₮), Angle Quotes (« »), Em-dash (—), NNBSP (\u202F)
// =============================================================================

default partial alphanumeric_keys
xkb_symbols "basic" {

  name[Group1]= "Mongolian (Ergonomic & DevOps)";

  // Number Row (AE01 - AE12)
  key <TLDE> { [ Cyrillic_io,        Cyrillic_IO,        asciitilde,         grave               ] };
  key <AE01> { [ 1,                  exclam,             numerosign,         exclamdown          ] };
  key <AE02> { [ 2,                  at,                 twosuperior,        at                  ] };
  key <AE03> { [ 3,                  numbersign,         threesuperior,      numbersign          ] };
  key <AE04> { [ 4,                  dollar,             U20ae,              currency            ] }; // AltGr+4 = Tugrik ₮
  key <AE05> { [ 5,                  percent,            EuroSign,           percent             ] };
  key <AE06> { [ 6,                  dead_circumflex,    onequarter,         asciicircum         ] };
  key <AE07> { [ 7,                  ampersand,          onehalf,            ampersand           ] };
  key <AE08> { [ 8,                  asterisk,           threequarters,      asterisk            ] };
  key <AE09> { [ 9,                  parenleft,          leftsinglequotemark, parenleft          ] };
  key <AE10> { [ 0,                  parenright,         rightsinglequotemark, parenright        ] };
  key <AE11> { [ minus,              underscore,         endash,             emdash              ] };
  key <AE12> { [ equal,              plus,               multiply,           division            ] };

  // Top Row (AD01 - AD12): Q W E R T Y U I O P [ ]
  key <AD01> { [ Cyrillic_o_bar,     Cyrillic_O_bar,     Cyrillic_hardsign,  Cyrillic_HARDSIGN   ] }; // Q = Ө, AltGr = Ъ
  key <AD02> { [ Cyrillic_u_straight,Cyrillic_U_straight,Cyrillic_softsign,  Cyrillic_SOFTSIGN   ] }; // W = Ү, AltGr = Ь
  key <AD03> { [ Cyrillic_e,         Cyrillic_E,         EuroSign,           NoSymbol            ] }; // E = Э
  key <AD04> { [ Cyrillic_er,        Cyrillic_ER,        registered,         NoSymbol            ] }; // R = Р
  key <AD05> { [ Cyrillic_te,        Cyrillic_TE,         U20ae,              NoSymbol            ] }; // T = Т, AltGr = ₮
  key <AD06> { [ Cyrillic_shorti,    Cyrillic_SHORTI,    Cyrillic_ie,        Cyrillic_IE         ] }; // Y = Й, AltGr = Е
  key <AD07> { [ Cyrillic_u,         Cyrillic_U,         doublelowquotemark, NoSymbol            ] }; // U = У
  key <AD08> { [ Cyrillic_i,         Cyrillic_I,         leftdoublequotemark, NoSymbol           ] }; // I = И
  key <AD09> { [ Cyrillic_o,         Cyrillic_O,         rightdoublequotemark, NoSymbol          ] }; // O = О
  key <AD10> { [ Cyrillic_pe,        Cyrillic_PE,        semicolon,          NoSymbol            ] }; // P = П
  key <AD11> { [ bracketleft,        braceleft,          guillemotleft,      Cyrillic_softsign   ] }; // [ { « ь
  key <AD12> { [ bracketright,       braceright,         guillemotright,     Cyrillic_hardsign   ] }; // ] } » ъ

  // Home Row (AC01 - AC11): A S D F G H J K L ; '
  key <AC01> { [ Cyrillic_a,         Cyrillic_A,         mu,                 NoSymbol            ] }; // A = А
  key <AC02> { [ Cyrillic_es,        Cyrillic_ES,        sterling,           NoSymbol            ] }; // S = С
  key <AC03> { [ Cyrillic_de,        Cyrillic_DE,        guillemotleft,      NoSymbol            ] }; // D = Д, AltGr = «
  key <AC04> { [ Cyrillic_ef,        Cyrillic_EF,        guillemotright,     NoSymbol            ] }; // F = Ф, AltGr = »
  key <AC05> { [ Cyrillic_ghe,       Cyrillic_GHE,       braceleft,          NoSymbol            ] }; // G = Г
  key <AC06> { [ Cyrillic_ha,        Cyrillic_HA,        less,               NoSymbol            ] }; // H = Х
  key <AC07> { [ Cyrillic_zhe,       Cyrillic_ZHE,       greater,            NoSymbol            ] }; // J = Ж
  key <AC08> { [ Cyrillic_ka,        Cyrillic_KA,        braceright,         NoSymbol            ] }; // K = К
  key <AC09> { [ Cyrillic_el,        Cyrillic_EL,        numerosign,         NoSymbol            ] }; // L = Л
  key <AC10> { [ semicolon,          colon,              Cyrillic_shcha,     Cyrillic_SHCHA      ] }; // ; : Щ
  key <AC11> { [ Cyrillic_yeru,      Cyrillic_YERU,      apostrophe,         quotedbl            ] }; // ' = Ы, AltGr = ' "
  key <BKSL> { [ backslash,          bar,                exclam,             NoSymbol            ] }; // \ |

  // Bottom Row (AB01 - AB10): Z X C V B N M , . /
  key <AB01> { [ Cyrillic_ze,        Cyrillic_ZE,        emdash,             NoSymbol            ] }; // Z = З
  key <AB02> { [ Cyrillic_sha,       Cyrillic_SHA,       Cyrillic_shcha,     Cyrillic_SHCHA      ] }; // X = Ш, AltGr = Щ
  key <AB03> { [ Cyrillic_tse,       Cyrillic_TSE,       copyright,          NoSymbol            ] }; // C = Ц
  key <AB04> { [ Cyrillic_ve,        Cyrillic_VE,        NoSymbol,           NoSymbol            ] }; // V = В
  key <AB05> { [ Cyrillic_be,        Cyrillic_BE,        degree,             NoSymbol            ] }; // B = Б
  key <AB06> { [ Cyrillic_en,        Cyrillic_EN,        less,               NoSymbol            ] }; // N = Н
  key <AB07> { [ Cyrillic_em,        Cyrillic_EM,        greater,            NoSymbol            ] }; // M = М
  key <AB08> { [ Cyrillic_che,       Cyrillic_CHE,       comma,              less                ] }; // , = Ч, AltGr = ,
  key <AB09> { [ Cyrillic_yu,        Cyrillic_YU,        period,             greater             ] }; // . = Ю, AltGr = .
  key <AB10> { [ Cyrillic_ya,        Cyrillic_YA,        question,           slash               ] }; // / = Я, AltGr = ?

  // Space Row (Includes NNBSP \u202F for Classical Script)
  key <SPCE> { [ space,              space,              0x100202f,          nobreakspace        ] };

  include "level3(ralt_switch)"
};
