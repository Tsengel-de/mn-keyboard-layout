// =============================================================================
// All-in-One Mongolian Keyboard Layout Suite for Linux (XKB)
// Author: Tsengel <tsengel@tsengel.de>
// Source: Tsengel mn-custom
//
// Integrated Variants:
// 1. "basic"  - Mongolian Cyrillic (Tsengel mn-custom, All 35 letters on Level 1 & 2)
// 2. "bichig" - Classical Mongolian Script (Tsengel Phonetic Logic)
// =============================================================================

// -----------------------------------------------------------------------------
// 1. DEFAULT: Mongolian Cyrillic (Tsengel mn-custom)
// -----------------------------------------------------------------------------
default partial alphanumeric_keys
xkb_symbols "basic" {

  name[Group1]= "Mongolian (Cyrillic - Tsengel)";

  // Number Row (AE01 - AE12)
  key <TLDE> { [ Cyrillic_io,        Cyrillic_IO,         asciitilde          ] };
  key <AE01> { [ 1,                  exclam,              numerosign          ] };
  key <AE02> { [ 2,                  at,                  twosuperior         ] };
  key <AE03> { [ 3,                  numbersign,          threesuperior       ] };
  key <AE04> { [ 4,                  dollar,              U20ae               ] }; // AltGr+4 = ₮
  key <AE05> { [ 5,                  percent,             EuroSign            ] };
  key <AE06> { [ 6,                  dead_circumflex,     onequarter          ] };
  key <AE07> { [ 7,                  ampersand,           onehalf             ] };
  key <AE08> { [ 8,                  asterisk,            threequarters       ] };
  key <AE09> { [ 9,                  parenleft,           leftsinglequotemark ] };
  key <AE10> { [ 0,                  parenright,          rightsinglequotemark] };
  key <AE11> { [ minus,              underscore,          yen                 ] };
  key <AE12> { [ equal,              plus,                multiply            ] };

  // Top Row (AD01 - AD12): Q W E R T Y U I O P [ ]
  key <AD01> { [ Cyrillic_hardsign,  Cyrillic_HARDSIGN,   apostrophe          ] }; // Q = ъ, Ъ
  key <AD02> { [ Cyrillic_softsign,  Cyrillic_SOFTSIGN,   grave               ] }; // W = ь, Ь
  key <AD03> { [ Cyrillic_e,         Cyrillic_E,          EuroSign            ] }; // E = э, Э
  key <AD04> { [ Cyrillic_er,        Cyrillic_ER,         registered          ] }; // R = р, Р
  key <AD05> { [ Cyrillic_te,        Cyrillic_TE,         U20ae               ] }; // T = т, Т, AltGr = ₮
  key <AD06> { [ Cyrillic_ie,        Cyrillic_IE,         trademark           ] }; // Y = е, Е (е товч энд байна!)
  key <AD07> { [ Cyrillic_u,         Cyrillic_U,          doublelowquotemark  ] }; // U = у, У
  key <AD08> { [ Cyrillic_i,         Cyrillic_I,          leftdoublequotemark ] }; // I = и, И
  key <AD09> { [ Cyrillic_o,         Cyrillic_O,          rightdoublequotemark] }; // O = о, О
  key <AD10> { [ Cyrillic_pe,        Cyrillic_PE,         semicolon           ] }; // P = п, П
  key <AD11> { [ Cyrillic_o_bar,     Cyrillic_O_bar,      bracketleft         ] }; // [ = ө, Ө, AltGr = [
  key <AD12> { [ Cyrillic_u_straight,Cyrillic_U_straight, bracketright        ] }; // ] = ү, Ү, AltGr = ]

  // Home Row (AC01 - AC11): A S D F G H J K L ; ' \
  key <AC01> { [ Cyrillic_a,         Cyrillic_A,          mu                  ] }; // A = а, А
  key <AC02> { [ Cyrillic_es,        Cyrillic_ES,         sterling            ] }; // S = с, С
  key <AC03> { [ Cyrillic_de,        Cyrillic_DE,         guillemotleft       ] }; // D = д, Д, AltGr = «
  key <AC04> { [ Cyrillic_ef,        Cyrillic_EF,         guillemotright      ] }; // F = ф, Ф, AltGr = »
  key <AC05> { [ Cyrillic_ghe,       Cyrillic_GHE,        braceleft           ] }; // G = г, Г, AltGr = {
  key <AC06> { [ Cyrillic_ha,        Cyrillic_HA,         less                ] }; // H = х, Х, AltGr = <
  key <AC07> { [ Cyrillic_zhe,       Cyrillic_ZHE,        greater             ] }; // J = ж, Ж, AltGr = >
  key <AC08> { [ Cyrillic_ka,        Cyrillic_KA,         braceright          ] }; // K = к, К, AltGr = }
  key <AC09> { [ Cyrillic_el,        Cyrillic_EL,         numerosign          ] }; // L = л, Л, AltGr = №
  key <AC10> { [ Cyrillic_shcha,     Cyrillic_SHCHA,      colon               ] }; // ; = щ, Щ, AltGr = :
  key <AC11> { [ Cyrillic_yeru,      Cyrillic_YERU,       ellipsis            ] }; // ' = ы, Ы, AltGr = …
  key <BKSL> { [ Cyrillic_shorti,    Cyrillic_SHORTI,     backslash           ] }; // \ = й, Й, AltGr = \

  key <LSGT> { [ slash,              bar,                 NoSymbol            ] };

  // Bottom Row (AB01 - AB10): Z X C V B N M , . /
  key <AB01> { [ Cyrillic_ze,        Cyrillic_ZE,         emdash              ] }; // Z = з, З
  key <AB02> { [ Cyrillic_sha,       Cyrillic_SHA,        endash              ] }; // X = ш, Ш
  key <AB03> { [ Cyrillic_tse,       Cyrillic_TSE,        copyright           ] }; // C = ц, Ц
  key <AB04> { [ Cyrillic_ve,        Cyrillic_VE,         NoSymbol            ] }; // V = в, В
  key <AB05> { [ Cyrillic_be,        Cyrillic_BE,         NoSymbol            ] }; // B = б, Б
  key <AB06> { [ Cyrillic_en,        Cyrillic_EN,         less                ] }; // N = н, Н
  key <AB07> { [ Cyrillic_em,        Cyrillic_EM,         greater             ] }; // M = м, М
  key <AB08> { [ Cyrillic_che,       Cyrillic_CHE,        comma               ] }; // , = ч, Ч, AltGr = ,
  key <AB09> { [ Cyrillic_yu,        Cyrillic_YU,         period              ] }; // . = ю, Ю, AltGr = .
  key <AB10> { [ Cyrillic_ya,        Cyrillic_YA,         question            ] }; // / = я, Я, AltGr = ?

  key <SPCE> { [ space,              space,               nobreakspace        ] };

  include "level3(ralt_switch)"
};

// -----------------------------------------------------------------------------
// 2. VARIANT: Classical Mongolian Script (Худам Монгол бичиг - Tsengel)
// -----------------------------------------------------------------------------
partial alphanumeric_keys
xkb_symbols "bichig" {

  name[Group1]= "Mongolian Script (Traditional - Tsengel)";

  // Classical Mongolian Digits
  key <TLDE> { [ 0x1001804, 0x1001800, asciitilde, grave ] }; // ᠄ (Nirugu), ᠀ (Birga)
  key <AE01> { [ 0x1001811, exclam,     1,          exclam ] }; // ᠑
  key <AE02> { [ 0x1001812, at,         2,          at     ] }; // ᠒
  key <AE03> { [ 0x1001813, numbersign, 3,          numbersign ] }; // ᠓
  key <AE04> { [ 0x1001814, dollar,     4,          0x10020ae  ] }; // ᠔, ₮
  key <AE05> { [ 0x1001815, percent,    5,          percent ] }; // ᠕
  key <AE06> { [ 0x1001816, asciicircum,6,          asciicircum ] }; // ᠖
  key <AE07> { [ 0x1001817, ampersand,  7,          ampersand ] }; // ᠗
  key <AE08> { [ 0x1001818, asterisk,   8,          asterisk ] }; // ᠘
  key <AE09> { [ 0x1001819, parenleft,  9,          parenleft ] }; // ᠙
  key <AE10> { [ 0x1001810, parenright, 0,          parenright ] }; // ᠐
  key <AE11> { [ minus,     underscore, endash,     emdash ] };
  key <AE12> { [ equal,     plus,       multiply,   division ] };

  // Top Row: Q W E R T Y U I O P [ ] \
  key <AD01> { [ 0x100180b, 0x100180e, apostrophe,  NoSymbol ] }; // Q = FVS1, Shift+Q = MVS
  key <AD02> { [ 0x100180c, 0x100180d, grave,       NoSymbol ] }; // W = FVS2, Shift+W = FVS3
  key <AD03> { [ 0x1001821, 0x1001821, 0x100180e,   EuroSign ] }; // E = ᠡ (E), AltGr = MVS
  key <AD04> { [ 0x1001837, 0x1001837, registered,  NoSymbol ] }; // R = ᠷ (R)
  key <AD05> { [ 0x1001832, 0x1001832, 0x10020ae,   NoSymbol ] }; // T = ᠲ (T), AltGr = ₮
  key <AD06> { [ 0x1001836, 0x1001836, trademark,   NoSymbol ] }; // Y = ᠶ (Y)
  key <AD07> { [ 0x1001824, 0x1001824, NoSymbol,    NoSymbol ] }; // U = ᠤ (U)
  key <AD08> { [ 0x1001822, 0x1001822, NoSymbol,    NoSymbol ] }; // I = ᠢ (I)
  key <AD09> { [ 0x1001823, 0x1001823, NoSymbol,    NoSymbol ] }; // O = ᠣ (O)
  key <AD10> { [ 0x100182b, 0x100182b, semicolon,   colon    ] }; // P = ᠫ (P)
  key <AD11> { [ 0x1001825, 0x1001825, bracketleft, braceleft] }; // [ = ᠥ (Ö), AltGr = [
  key <AD12> { [ 0x1001826, 0x1001826, bracketright,braceright]}; // ] = ᠦ (Ü), AltGr = ]
  key <BKSL> { [ backslash, bar,        NoSymbol,    NoSymbol ] };

  // Home Row: A S D F G H J K L ; '
  key <AC01> { [ 0x1001820, 0x1001820, NoSymbol,    NoSymbol ] }; // A = ᠠ (A)
  key <AC02> { [ 0x1001830, 0x1001830, NoSymbol,    NoSymbol ] }; // S = ᠰ (S)
  key <AC03> { [ 0x1001833, 0x1001833, 0x1001808,   NoSymbol ] }; // D = ᠳ (D), AltGr = ᠈
  key <AC04> { [ 0x1001839, 0x1001839, 0x1001809,   NoSymbol ] }; // F = ᠹ (F), AltGr = ᠉
  key <AC05> { [ 0x100182d, 0x100182d, braceleft,   NoSymbol ] }; // G = ᠭ (G)
  key <AC06> { [ 0x100182c, 0x100182c, less,        NoSymbol ] }; // H = ᠬ (H)
  key <AC07> { [ 0x1001835, 0x1001835, greater,     NoSymbol ] }; // J = ᠵ (J)
  key <AC08> { [ 0x100183a, 0x100183a, braceright,  NoSymbol ] }; // K = ᠺ (K)
  key <AC09> { [ 0x100182f, 0x100182f, numerosign,  NoSymbol ] }; // L = ᠯ (L)
  key <AC10> { [ semicolon, colon,     NoSymbol,    NoSymbol ] };
  key <AC11> { [ apostrophe,quotedbl,  0x100180e,   NoSymbol ] }; // ' " MVS

  // Bottom Row: Z X C V B N M , . /
  key <AB01> { [ 0x100183d, 0x100183d, NoSymbol,    NoSymbol ] }; // Z = ᠽ (Z)
  key <AB02> { [ 0x1001831, 0x1001831, NoSymbol,    NoSymbol ] }; // X = ᠱ (Sh)
  key <AB03> { [ 0x100183c, 0x100183c, copyright,   NoSymbol ] }; // C = ᠼ (Ts)
  key <AB04> { [ 0x1001838, 0x1001838, NoSymbol,    NoSymbol ] }; // V = ᠸ (V/W)
  key <AB05> { [ 0x100182a, 0x100182a, NoSymbol,    NoSymbol ] }; // B = ᠪ (B)
  key <AB06> { [ 0x1001828, 0x1001829, less,        NoSymbol ] }; // N = ᠨ, Shift+N = ᠩ
  key <AB07> { [ 0x100182e, 0x100182e, greater,     NoSymbol ] }; // M = ᠮ (M)
  key <AB08> { [ 0x1001834, comma,     0x1001802,   less     ] }; // , = ᠴ (Ch), Shift+, = ,, AltGr = ᠂
  key <AB09> { [ 0x1001803, period,    0x1001803,   greater  ] }; // . = ᠃ (Tseg), Shift+. = .
  key <AB10> { [ slash,     question,  NoSymbol,    NoSymbol ] };

  // Space: Space & NNBSP (\u202F)
  key <SPCE> { [ space,     0x100202f, 0x100202f,   nobreakspace ] }; // Shift+Space = NNBSP

  include "level3(ralt_switch)"
};
